{
  "name": "cpp-core",
  "version": "1.0.0-rc.1",
  "description": "Context Provenance Protocol — content-addressed serialization for LLM and agentic harnesses",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "cpp",
    "context-provenance",
    "content-addressed",
    "cid",
    "dag-cbor",
    "ipld",
    "did-key",
    "ed25519",
    "mcp",
    "model-context-protocol",
    "llm",
    "agent",
    "provenance",
    "signatures"
  ],
  "author": "agisota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agisota/cpp-core.git"
  },
  "bugs": {
    "url": "https://github.com/agisota/cpp-core/issues"
  },
  "homepage": "https://github.com/agisota/cpp-core#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@ipld/dag-cbor": "^9.2.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "multiformats": "^13.3.0"
  }
}
